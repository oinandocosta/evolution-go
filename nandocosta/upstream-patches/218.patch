From 1666b39110c0219d5bea19501748e34f62b2864e Mon Sep 17 00:00:00 2001
From: Jaquison Ferreira <jaquison@oriflow.io>
Date: Sat, 10 Oct 2026 22:20:15 -0300
Subject: [PATCH 1/2] test: ensure on-demand history sync request is sent to
 own primary device

---
 pkg/chat/service/history_sync_test.go | 70 +++++++++++++++++++++++++++
 1 file changed, 70 insertions(+)
 create mode 100644 pkg/chat/service/history_sync_test.go

diff --git a/pkg/chat/service/history_sync_test.go b/pkg/chat/service/history_sync_test.go
new file mode 100644
index 000000000..68291dacb
--- /dev/null
+++ b/pkg/chat/service/history_sync_test.go
@@ -0,0 +1,70 @@
+package chat_service
+
+import (
+	"context"
+	"errors"
+	"testing"
+	"time"
+
+	"go.mau.fi/whatsmeow"
+	"go.mau.fi/whatsmeow/proto/waE2E"
+	"go.mau.fi/whatsmeow/types"
+)
+
+type recordingPeerSender struct {
+	sent []*waE2E.Message
+	err  error
+}
+
+func (r *recordingPeerSender) BuildHistorySyncRequest(info *types.MessageInfo, count int) *waE2E.Message {
+	return (&whatsmeow.Client{}).BuildHistorySyncRequest(info, count)
+}
+
+func (r *recordingPeerSender) SendPeerMessage(_ context.Context, message *waE2E.Message) (whatsmeow.SendResponse, error) {
+	r.sent = append(r.sent, message)
+	return whatsmeow.SendResponse{ID: "PEER1"}, r.err
+}
+
+func TestRequestHistorySyncSendsToOwnPrimaryDevice(t *testing.T) {
+	sender := &recordingPeerSender{}
+	chat := types.NewJID("95336127295713", types.HiddenUserServer)
+	info := &types.MessageInfo{
+		MessageSource: types.MessageSource{Chat: chat, IsFromMe: false},
+		ID:            "3A26EBAB519B7497FCC1",
+		Timestamp:     time.Unix(1760144000, 0),
+	}
+
+	res, err := requestHistorySync(context.Background(), sender, info, 30)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	if res.ID != "PEER1" {
+		t.Fatalf("expected peer response id, got %q", res.ID)
+	}
+	if len(sender.sent) != 1 {
+		t.Fatalf("expected one peer message, got %d", len(sender.sent))
+	}
+
+	request := sender.sent[0].GetProtocolMessage().GetPeerDataOperationRequestMessage().GetHistorySyncOnDemandRequest()
+	if request.GetChatJID() != chat.String() {
+		t.Errorf("expected chat %q, got %q", chat.String(), request.GetChatJID())
+	}
+	if request.GetOldestMsgID() != info.ID {
+		t.Errorf("expected oldest message %q, got %q", info.ID, request.GetOldestMsgID())
+	}
+	if request.GetOnDemandMsgCount() != 30 {
+		t.Errorf("expected count 30, got %d", request.GetOnDemandMsgCount())
+	}
+	if request.GetOldestMsgTimestampMS() != info.Timestamp.Unix() {
+		t.Errorf("expected timestamp %d, got %d", info.Timestamp.Unix(), request.GetOldestMsgTimestampMS())
+	}
+}
+
+func TestRequestHistorySyncPropagatesSendError(t *testing.T) {
+	sender := &recordingPeerSender{err: errors.New("not logged in")}
+	info := &types.MessageInfo{ID: "X", Timestamp: time.Unix(1, 0)}
+
+	if _, err := requestHistorySync(context.Background(), sender, info, 10); err == nil {
+		t.Fatal("expected error to be propagated")
+	}
+}

From 86b4145b336ec8f426846a2e46b2870623282e2f Mon Sep 17 00:00:00 2001
From: Jaquison Ferreira <jaquison@oriflow.io>
Date: Sat, 10 Oct 2026 22:20:15 -0300
Subject: [PATCH 2/2] fix: send on-demand history sync request to own primary
 device

HistorySyncRequest sent the peer data operation to the chat JID, so the
request reached the contact instead of the account's primary phone and
no HistorySync ON_DEMAND event was ever emitted. Use SendPeerMessage,
which targets the account's own JID as whatsmeow requires.
---
 pkg/chat/service/chat_service.go | 14 +++++++++++---
 1 file changed, 11 insertions(+), 3 deletions(-)

diff --git a/pkg/chat/service/chat_service.go b/pkg/chat/service/chat_service.go
index c4eda9d7b..39ff4c78a 100644
--- a/pkg/chat/service/chat_service.go
+++ b/pkg/chat/service/chat_service.go
@@ -11,6 +11,7 @@ import (
 	whatsmeow_service "github.com/evolution-foundation/evolution-go/pkg/whatsmeow/service"
 	"go.mau.fi/whatsmeow"
 	"go.mau.fi/whatsmeow/appstate"
+	"go.mau.fi/whatsmeow/proto/waE2E"
 	"go.mau.fi/whatsmeow/types"
 )
 
@@ -232,9 +233,7 @@ func (c *chatService) HistorySyncRequest(data *HistorySyncRequestStruct, instanc
 		Timestamp: data.MessageInfo.Timestamp,
 	}
 
-	histRequest := client.BuildHistorySyncRequest(&messageInfo, data.Count)
-
-	res, err := client.SendMessage(context.Background(), messageInfo.Chat, histRequest, whatsmeow.SendRequestExtra{Peer: true})
+	res, err := requestHistorySync(context.Background(), client, &messageInfo, data.Count)
 	if err != nil {
 		c.loggerWrapper.GetLogger(instance.Id).LogError("[%s] error history sync request: %v", instance.Id, err)
 		return nil, err
@@ -243,6 +242,15 @@ func (c *chatService) HistorySyncRequest(data *HistorySyncRequestStruct, instanc
 	return &res, nil
 }
 
+type historySyncSender interface {
+	BuildHistorySyncRequest(lastKnownMessageInfo *types.MessageInfo, count int) *waE2E.Message
+	SendPeerMessage(ctx context.Context, message *waE2E.Message) (whatsmeow.SendResponse, error)
+}
+
+func requestHistorySync(ctx context.Context, sender historySyncSender, messageInfo *types.MessageInfo, count int) (whatsmeow.SendResponse, error) {
+	return sender.SendPeerMessage(ctx, sender.BuildHistorySyncRequest(messageInfo, count))
+}
+
 func NewChatService(
 	clientPointer map[string]*whatsmeow.Client,
 	whatsmeowService whatsmeow_service.WhatsmeowService,
