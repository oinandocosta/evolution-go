+func TestStartThenImmediateStopLeavesNoLateLifecycle(t *testing.T) {
+	previousProcs := runtime.GOMAXPROCS(1)
+	defer runtime.GOMAXPROCS(previousProcs)
+
+	baseDir := t.TempDir()
+	if err := os.MkdirAll(filepath.Join(baseDir, "dbdata"), 0o755); err != nil {
