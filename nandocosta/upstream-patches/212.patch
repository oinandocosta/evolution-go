+func TestImageDimensions_InvalidDataReturnsNil(t *testing.T) {
+	w, h := imageDimensions([]byte("not an image"))
+	if w != nil || h != nil {
+		t.Fatal("expected nil dimensions for invalid data")
+	}
+}
