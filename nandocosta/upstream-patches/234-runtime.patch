diff --git a/pkg/runtimestate/map.go b/pkg/runtimestate/map.go
new file mode 100644
index 0000000..3e13762
--- /dev/null
+++ b/pkg/runtimestate/map.go
@@ -0,0 +1,80 @@
+// Package runtimestate owns the synchronized registries shared by HTTP handlers
+// and WhatsApp event goroutines. Locks cover registry access only, never network I/O.
+package runtimestate
+
+import "sync"
+
+type Map[K comparable, V comparable] struct {
+	mu     sync.RWMutex
+	values map[K]V
+	guards map[K]*keyGuard
+}
+
+func New[K comparable, V comparable]() *Map[K, V] { return &Map[K, V]{} }
+
+func (m *Map[K, V]) Load(key K) (V, bool) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	value, ok := m.values[key]
+	return value, ok
+}
+
+func (m *Map[K, V]) Get(key K) V { value, _ := m.Load(key); return value }
+
+func (m *Map[K, V]) Set(key K, value V) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.values == nil {
+		m.values = make(map[K]V)
+	}
+	m.values[key] = value
+}
+
+func (m *Map[K, V]) Delete(key K) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	delete(m.values, key)
+}
+
+// CompareAndDelete prevents an old client teardown from deleting a newer client.
+func (m *Map[K, V]) CompareAndDelete(key K, expected V) bool {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	current, ok := m.values[key]
+	if !ok || current != expected {
+		return false
+	}
+	delete(m.values, key)
+	return true
+}
+
+type keyGuard struct {
+	mu    sync.Mutex
+	users int
+}
+
+// LockKey serializes lifecycle operations for one instance, without holding a
+// registry mutex during network I/O. References keep queued users on the same lock.
+func (m *Map[K, V]) LockKey(key K) func() {
+	m.mu.Lock()
+	if m.guards == nil {
+		m.guards = make(map[K]*keyGuard)
+	}
+	guard := m.guards[key]
+	if guard == nil {
+		guard = &keyGuard{}
+		m.guards[key] = guard
+	}
+	guard.users++
+	m.mu.Unlock()
+	guard.mu.Lock()
+	return func() {
+		guard.mu.Unlock()
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		guard.users--
+		if guard.users == 0 {
+			delete(m.guards, key)
+		}
+	}
+}
diff --git a/pkg/runtimestate/map_test.go b/pkg/runtimestate/map_test.go
new file mode 100644
index 0000000..6609ec4
--- /dev/null
+++ b/pkg/runtimestate/map_test.go
@@ -0,0 +1,87 @@
+package runtimestate
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+)
+
+func TestMapZeroValueAndMissingEntries(t *testing.T) {
+	var m Map[string, int]
+	if got, ok := m.Load("absent"); ok || got != 0 {
+		t.Fatal("missing entry must have zero value")
+	}
+	m.Set("present", 7)
+	if got := m.Get("present"); got != 7 {
+		t.Fatalf("got %d", got)
+	}
+	m.Delete("present")
+	m.Delete("present")
+	if _, ok := m.Load("present"); ok {
+		t.Fatal("cleanup must be idempotent")
+	}
+}
+
+func TestConcurrentLogoutCleanupPreservesOtherSessions(t *testing.T) {
+	clients := New[string, int]()
+	metadata := New[string, int]()
+	controls := New[string, int]()
+	for _, m := range []*Map[string, int]{clients, metadata, controls} {
+		m.Set("other-connected-number", 2)
+		m.Set("closing", 1)
+	}
+	start := make(chan struct{})
+	var wg sync.WaitGroup
+	for worker := 0; worker < 24; worker++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			<-start
+			for n := 0; n < 10000; n++ {
+				for _, m := range []*Map[string, int]{clients, metadata, controls} {
+					m.Delete("closing")
+					if m.Get("other-connected-number") != 2 {
+						t.Error("unrelated session changed")
+						return
+					}
+				}
+			}
+		}()
+	}
+	close(start)
+	wg.Wait()
+	for _, m := range []*Map[string, int]{clients, metadata, controls} {
+		if _, ok := m.Load("closing"); ok {
+			t.Fatal("closed entry remains")
+		}
+		if m.Get("other-connected-number") != 2 {
+			t.Fatal("unrelated session missing")
+		}
+	}
+}
+
+func TestConcurrentRegistryReadsWritesAndRemovals(t *testing.T) {
+	m := New[string, int]()
+	m.Set("untouched", 42)
+	var wg sync.WaitGroup
+	for worker := 0; worker < 24; worker++ {
+		wg.Add(1)
+		go func(worker int) {
+			defer wg.Done()
+			key := fmt.Sprintf("worker-%d", worker)
+			for n := 0; n < 10000; n++ {
+				m.Set(key, n)
+				if got := m.Get(key); got != n {
+					t.Errorf("worker entry changed: %d", got)
+					return
+				}
+				m.Load(key)
+				m.Delete(key)
+			}
+		}(worker)
+	}
+	wg.Wait()
+	if m.Get("untouched") != 42 {
+		t.Fatal("unrelated instance was removed")
+	}
+}
diff --git a/pkg/runtimestate/stop_signal.go b/pkg/runtimestate/stop_signal.go
new file mode 100644
index 0000000..dc3dc90
--- /dev/null
+++ b/pkg/runtimestate/stop_signal.go
@@ -0,0 +1,130 @@
+package runtimestate
+
+import (
+	"fmt"
+	"sync"
+	"time"
+)
+
+// StopSignal broadcasts an idempotent stop to the workers of one generation.
+type StopSignal struct {
+	init         sync.Once
+	mu           sync.Mutex
+	started      bool
+	stopped      bool
+	done         chan struct{}
+	finished     chan struct{}
+	finishedOnce sync.Once
+	workers      sync.WaitGroup
+}
+
+func NewStopSignal() *StopSignal { s := &StopSignal{}; s.initialize(); return s }
+func (s *StopSignal) initialize() {
+	s.init.Do(func() { s.done = make(chan struct{}); s.finished = make(chan struct{}) })
+}
+func (s *StopSignal) Done() <-chan struct{} {
+	if s == nil {
+		return nil
+	}
+	s.initialize()
+	return s.done
+}
+func (s *StopSignal) Begin() bool {
+	if s == nil {
+		return false
+	}
+	s.initialize()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.started || s.stopped {
+		return false
+	}
+	s.started = true
+	return true
+}
+func (s *StopSignal) Stop() {
+	if s == nil {
+		return
+	}
+	s.initialize()
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if !s.stopped {
+		s.stopped = true
+		close(s.done)
+	}
+	if !s.started {
+		s.Complete()
+	}
+}
+func (s *StopSignal) Complete() {
+	if s == nil {
+		return
+	}
+	s.initialize()
+	s.workers.Wait()
+	s.finishedOnce.Do(func() { close(s.finished) })
+}
+func (s *StopSignal) Wait(timeout time.Duration) bool {
+	if s == nil {
+		return true
+	}
+	s.initialize()
+	timer := time.NewTimer(timeout)
+	defer timer.Stop()
+	select {
+	case <-s.finished:
+		return true
+	case <-timer.C:
+		return false
+	}
+}
+
+// NewGeneration waits for the previous worker to finish its database/cache cleanup
+// before exposing a replacement. Concurrent starts are serialized only for this ID.
+func NewGeneration(registry *Map[string, *StopSignal], id string, timeout time.Duration) (*StopSignal, error) {
+	unlock := registry.LockKey(id)
+	defer unlock()
+	return NewGenerationLocked(registry, id, timeout)
+}
+
+// NewGenerationLocked requires the caller to hold registry.LockKey(id).
+func NewGenerationLocked(registry *Map[string, *StopSignal], id string, timeout time.Duration) (*StopSignal, error) {
+	previous := registry.Get(id)
+	previous.Stop()
+	if !previous.Wait(timeout) {
+		return nil, fmt.Errorf("previous connection is still stopping")
+	}
+	signal := NewStopSignal()
+	registry.Set(id, signal)
+	return signal, nil
+}
+
+// Run tracks side-effect workers so a replacement cannot outlive their cleanup.
+func (s *StopSignal) Run(work func()) bool {
+	if s == nil {
+		return false
+	}
+	s.initialize()
+	s.mu.Lock()
+	if s.stopped || !s.started {
+		s.mu.Unlock()
+		return false
+	}
+	s.workers.Add(1)
+	s.mu.Unlock()
+	go func() { defer s.workers.Done(); work() }()
+	return true
+}
+
+// Sleep waits for rotation timing while remaining responsive to session stop.
+func (s *StopSignal) Sleep(duration time.Duration) bool {
+	timer := time.NewTimer(duration)
+	defer timer.Stop()
+	select {
+	case <-s.Done():
+		return false
+	case <-timer.C:
+		return true
+	}
+}
diff --git a/pkg/runtimestate/stop_signal_test.go b/pkg/runtimestate/stop_signal_test.go
new file mode 100644
index 0000000..34ef31e
--- /dev/null
+++ b/pkg/runtimestate/stop_signal_test.go
@@ -0,0 +1,174 @@
+package runtimestate
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+func TestStopSignalReleasesAllWorkersAndIsIdempotent(t *testing.T) {
+	var signal StopSignal
+	var workers, stoppers sync.WaitGroup
+	for n := 0; n < 24; n++ {
+		workers.Add(1)
+		go func() {
+			defer workers.Done()
+			select {
+			case <-signal.Done():
+			case <-time.After(2 * time.Second):
+				t.Error("stop was not broadcast")
+			}
+		}()
+	}
+	for n := 0; n < 24; n++ {
+		stoppers.Add(1)
+		go func() {
+			defer stoppers.Done()
+			for i := 0; i < 100; i++ {
+				signal.Stop()
+			}
+		}()
+	}
+	stoppers.Wait()
+	workers.Wait()
+	signal.Stop()
+}
+func TestStoppedGenerationDoesNotStopReplacement(t *testing.T) {
+	old := NewStopSignal()
+	next := NewStopSignal()
+	old.Stop()
+	select {
+	case <-next.Done():
+		t.Fatal("replacement stopped")
+	default:
+	}
+}
+
+func TestOldGenerationCleanupCannotRemoveReplacement(t *testing.T) {
+	clients := New[string, int]()
+	signals := New[string, *StopSignal]()
+	old := NewStopSignal()
+	next := NewStopSignal()
+	clients.Set("number", 2)
+	signals.Set("number", next)
+	if clients.CompareAndDelete("number", 1) {
+		t.Fatal("old client removed replacement")
+	}
+	if signals.CompareAndDelete("number", old) {
+		t.Fatal("old signal removed replacement")
+	}
+	if clients.Get("number") != 2 || signals.Get("number") != next {
+		t.Fatal("replacement changed")
+	}
+}
+
+func TestNewGenerationWaitsForOldCleanup(t *testing.T) {
+	registry := New[string, *StopSignal]()
+	old := NewStopSignal()
+	if !old.Begin() {
+		t.Fatal("begin")
+	}
+	registry.Set("number", old)
+	result := make(chan *StopSignal, 1)
+	failure := make(chan error, 1)
+	go func() { next, err := NewGeneration(registry, "number", time.Second); result <- next; failure <- err }()
+	<-old.Done()
+	if registry.Get("number") != old {
+		t.Fatal("replacement exposed before cleanup")
+	}
+	old.Complete()
+	next := <-result
+	if err := <-failure; err != nil {
+		t.Fatal(err)
+	}
+	if registry.Get("number") != next || !next.Begin() {
+		t.Fatal("replacement not active")
+	}
+	next.Stop()
+	next.Complete()
+}
+
+func TestNewGenerationTimeoutRetainsOldHandle(t *testing.T) {
+	registry := New[string, *StopSignal]()
+	old := NewStopSignal()
+	old.Begin()
+	registry.Set("number", old)
+	if _, err := NewGeneration(registry, "number", time.Millisecond); err == nil {
+		t.Fatal("must wait for cleanup")
+	}
+	if registry.Get("number") != old {
+		t.Fatal("timed out start replaced old session")
+	}
+	old.Complete()
+}
+
+func TestSupersededUnstartedGenerationCannotStart(t *testing.T) {
+	registry := New[string, *StopSignal]()
+	first, err := NewGeneration(registry, "number", time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	next, err := NewGeneration(registry, "number", time.Second)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if first.Begin() {
+		t.Fatal("superseded generation started")
+	}
+	if !next.Begin() {
+		t.Fatal("current generation did not start")
+	}
+	next.Stop()
+	next.Complete()
+}
+
+func TestGenerationCompletionWaitsForChildWorkers(t *testing.T) {
+	signal := NewStopSignal()
+	signal.Begin()
+	entered := make(chan struct{})
+	release := make(chan struct{})
+	if !signal.Run(func() { close(entered); <-release }) {
+		t.Fatal("worker not accepted")
+	}
+	<-entered
+	signal.Stop()
+	go signal.Complete()
+	if signal.Wait(time.Millisecond) {
+		t.Fatal("finished before worker cleanup")
+	}
+	close(release)
+	if !signal.Wait(time.Second) {
+		t.Fatal("worker never finished")
+	}
+	if signal.Run(func() { t.Error("worker started after stop") }) {
+		t.Fatal("stopped generation accepted worker")
+	}
+}
+
+func TestRotationSleepIsInterruptedByStop(t *testing.T) {
+	signal := NewStopSignal()
+	result := make(chan bool, 1)
+	go func() { result <- signal.Sleep(time.Hour) }()
+	signal.Stop()
+	select {
+	case elapsed := <-result:
+		if elapsed {
+			t.Fatal("old QR rotation continued")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("rotation did not stop")
+	}
+}
+
+func TestLifecycleLockDoesNotBlockAnotherNumber(t *testing.T) {
+	registry := New[string, int]()
+	unlock := registry.LockKey("one")
+	defer unlock()
+	done := make(chan struct{})
+	go func() { release := registry.LockKey("other"); release(); close(done) }()
+	select {
+	case <-done:
+	case <-time.After(time.Second):
+		t.Fatal("per-instance operation locked every instance")
+	}
